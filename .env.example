# Seaglass configuration contract. Settings.load (src/aspire_brain/config.py) reads .env in the
# project root, then the process environment, which wins. A relative path resolves against the
# project root. init-demo writes a .env with the values below and creates the secrets in var/
# with mode 0600. Startup fails closed on any invalid value instead of falling back.

# -- Mode -------------------------------------------------------------------------------------
# true enables the persona sign-in used by the demo. With false there is no identity provider
# and every request needing a user is refused. Default when unset: false.
ASPIRE_DEMO_MODE=true
# offline_extractive (default, no network), fake_grounded (local test provider) or
# live_grounded (opt-in Groq, fictional fixture only; see "Live provider" below).
ASPIRE_PROVIDER_MODE=offline_extractive

# -- Storage and secrets ----------------------------------------------------------------------
ASPIRE_DB_PATH=var/aspire.db
# Required. Each file holds at least 32 bytes, has mode 0600, and differs from the others.
ASPIRE_SESSION_KEY_PATH=var/session.key
ASPIRE_AUDIT_KEY_PATH=var/audit.key
ASPIRE_PAYLOAD_KEY_PATH=var/payload.key
# Separate append-only record of each audit chain head. Optional for an older checkout, but once
# the key path is set or the witness file has content, a missing key stops startup.
ASPIRE_AUDIT_WITNESS_PATH=var/audit-witness/witness.jsonl
ASPIRE_AUDIT_WITNESS_KEY_PATH=var/audit-witness/witness.key

# -- Protected audit payload retention (positive integers) ------------------------------------
ASPIRE_AUDIT_RETENTION_DAYS=90
ASPIRE_AUDIT_RETENTION_MAX_ENTRIES=10000

# -- Four-platform index ----------------------------------------------------------------------
# fixture (fictional bundle, default) or connectors (real accounts; needs
# ASPIRE_CONNECTORS_CONFIG, see eval/live_platform/README.md).
ASPIRE_PLATFORM_SOURCE=fixture
# ASPIRE_CONNECTORS_CONFIG=
# Overrides the fixture bundle location. Default: data/fixtures/fintech_operations, else the
# copy shipped in the package.
# ASPIRE_FIXTURE_ROOT=
# Seconds between scheduled syncs (0 turns the loop off); must be shorter than the budget.
ASPIRE_SYNC_INTERVAL_SECONDS=300
# A platform not synchronized within this many seconds is reported stale and not quoted.
ASPIRE_FRESHNESS_BUDGET_SECONDS=3600

# -- Hosted demo (shared public demo behind a TLS-terminating proxy) ---------------------------
# Off by default: only loopback hosts are accepted. When true, ASPIRE_ALLOWED_HOSTS is required
# (plain comma-separated hostnames), the provider must be offline_extractive, no live provider
# setting may be present and the platform source must be fixture.
# ASPIRE_HOSTED_DEMO=false
# ASPIRE_ALLOWED_HOSTS=

# -- Live provider (only with ASPIRE_PROVIDER_MODE=live_grounded) -----------------------------
# live_grounded refuses before any request unless every setting below matches the approved
# target and limits, the key file lives outside the project, and the spend ledger is writable.
# It also refuses ASPIRE_PLATFORM_SOURCE=connectors and hosted demo mode.
# ASPIRE_PROVIDER_SERVICE=
# ASPIRE_PROVIDER_MODEL=
# ASPIRE_PROVIDER_ENDPOINT=
# ASPIRE_PROVIDER_REGION=
# ASPIRE_PROVIDER_REGION_PROVENANCE=
# ASPIRE_PROVIDER_ENABLED=false
# ASPIRE_PROVIDER_ENTITLEMENT=
# ASPIRE_PROVIDER_MAX_COST_USD=
# ASPIRE_PROVIDER_TIMEOUT_SECONDS=
# ASPIRE_PROVIDER_REQUEST_CAP=
# ASPIRE_PROVIDER_INPUT_TOKEN_CAP=
# ASPIRE_PROVIDER_OUTPUT_TOKEN_CAP=
# ASPIRE_PROVIDER_REASONING_TOKEN_CAP=
# ASPIRE_PROVIDER_TOTAL_TOKEN_CAP=
# ASPIRE_PROVIDER_REASONING_EFFORT=
# ASPIRE_PROVIDER_KEY_PATH=~/.config/seaglass/provider.key
# ASPIRE_PROVIDER_LEDGER_PATH=var/provider/live-ledger.jsonl
