# init-demo generates separate secrets in var/ with mode 0600.
ASPIRE_DEMO_MODE=true
ASPIRE_PROVIDER_MODE=offline_extractive
ASPIRE_DB_PATH=var/aspire.db
ASPIRE_SESSION_KEY_PATH=var/session.key
ASPIRE_AUDIT_KEY_PATH=var/audit.key
ASPIRE_PAYLOAD_KEY_PATH=var/payload.key
# Declared retention for encrypted protected audit payloads.
ASPIRE_AUDIT_RETENTION_DAYS=90
ASPIRE_AUDIT_RETENTION_MAX_ENTRIES=10000
# The application has no live provider: offline_extractive (default) and fake_grounded
# run locally, and live_grounded is refused. These values mirror what init-demo writes.
